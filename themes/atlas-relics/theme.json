{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#F4EFE4",
          "name": "Ivory",
          "slug": "ivory"
        },
        {
          "color": "#FAF6EE",
          "name": "Paper",
          "slug": "paper"
        },
        {
          "color": "#E8DFD0",
          "name": "Parchment",
          "slug": "parchment"
        },
        {
          "color": "#1A1714",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#101820",
          "name": "Navy",
          "slug": "navy"
        },
        {
          "color": "#1C2128",
          "name": "Charcoal",
          "slug": "charcoal"
        },
        {
          "color": "#B08D57",
          "name": "Gold",
          "slug": "gold"
        },
        {
          "color": "#8A6D3F",
          "name": "Gold Dark",
          "slug": "gold-dark"
        },
        {
          "color": "#6A6358",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#D5CBBA",
          "name": "Line",
          "slug": "line"
        },
        {
          "color": "#2A3544",
          "name": "Navy Line",
          "slug": "navy-line"
        }
      ]
    },
    "layout": {
      "contentSize": "42rem",
      "wideSize": "78rem"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "2XS",
          "size": "0.5rem",
          "slug": "10"
        },
        {
          "name": "XS",
          "size": "0.75rem",
          "slug": "20"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "30"
        },
        {
          "name": "Medium",
          "size": "1.5rem",
          "slug": "40"
        },
        {
          "name": "Large",
          "size": "clamp(1.75rem, 3vw, 2.5rem)",
          "slug": "50"
        },
        {
          "name": "XL",
          "size": "clamp(2.5rem, 5vw, 4rem)",
          "slug": "60"
        },
        {
          "name": "2XL",
          "size": "clamp(3.5rem, 7vw, 6rem)",
          "slug": "70"
        },
        {
          "name": "3XL",
          "size": "clamp(4.5rem, 10vw, 8rem)",
          "slug": "80"
        }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "name": "Display",
          "slug": "display",
          "fontFamily": "\"Cormorant Garamond\", \"Palatino Linotype\", Palatino, serif",
          "fontFace": [
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/cormorant-garamond/cormorant-garamond-latin-400-normal.woff2"]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/cormorant-garamond/cormorant-garamond-latin-500-normal.woff2"]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/cormorant-garamond/cormorant-garamond-latin-600-normal.woff2"]
            },
            {
              "fontFamily": "Cormorant Garamond",
              "fontWeight": "400",
              "fontStyle": "italic",
              "src": ["file:./assets/fonts/cormorant-garamond/cormorant-garamond-latin-400-italic.woff2"]
            }
          ]
        },
        {
          "name": "Serif",
          "slug": "serif",
          "fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
          "fontFace": [
            {
              "fontFamily": "Source Serif 4",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/source-serif-4/source-serif-4-latin-400-normal.woff2"]
            },
            {
              "fontFamily": "Source Serif 4",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/source-serif-4/source-serif-4-latin-600-normal.woff2"]
            },
            {
              "fontFamily": "Source Serif 4",
              "fontWeight": "400",
              "fontStyle": "italic",
              "src": ["file:./assets/fonts/source-serif-4/source-serif-4-latin-400-italic.woff2"]
            }
          ]
        },
        {
          "name": "Sans",
          "slug": "sans",
          "fontFamily": "\"Source Sans 3\", \"Segoe UI\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/source-sans-3/source-sans-3-latin-400-normal.woff2"]
            },
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/source-sans-3/source-sans-3-latin-500-normal.woff2"]
            },
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "600",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/source-sans-3/source-sans-3-latin-600-normal.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.8125rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          },
          "name": "Large",
          "size": "1.125rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "Extra Large",
          "size": "1.5rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2.15rem",
            "max": "3.15rem"
          },
          "name": "2X Large",
          "size": "2.15rem",
          "slug": "xx-large"
        },
        {
          "fluid": {
            "min": "2.75rem",
            "max": "4.75rem"
          },
          "name": "Display",
          "size": "2.75rem",
          "slug": "xxx-large"
        }
      ]
    },
    "custom": {
      "lineHeight": {
        "tight": "1.15",
        "snug": "1.3",
        "body": "1.7",
        "relaxed": "1.85"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ivory",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|serif",
      "fontSize": "var:preset|font-size|large",
      "fontWeight": "400",
      "lineHeight": "1.7"
    },
    "css": "body { background-image: linear-gradient(180deg, color-mix(in srgb, var(--wp--preset--color--parchment) 35%, transparent) 0, transparent 18rem); } @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }",
    "elements": {
      "button": {
        "border": {
          "radius": "0",
          "color": "var:preset|color|navy",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var:preset|color|navy",
          "text": "var:preset|color|ivory"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.4rem",
            "bottom": "0.85rem",
            "left": "1.4rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase",
          "lineHeight": "1.2"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|charcoal",
            "text": "var:preset|color|ivory"
          },
          "border": {
            "color": "var:preset|color|charcoal"
          }
        },
        ":focus": {
          "outline": {
            "color": "var:preset|color|gold",
            "offset": "3px",
            "width": "2px",
            "style": "solid"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|xxx-large",
          "fontWeight": "500",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.12"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "500",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.18"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "500",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.14em",
          "textTransform": "uppercase"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "underline",
          "textDecorationThickness": "1px",
          "textUnderlineOffset": "0.18em"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|gold-dark"
          }
        },
        ":focus": {
          "outline": {
            "color": "var:preset|color|gold",
            "offset": "3px",
            "width": "2px",
            "style": "solid"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "500",
          "letterSpacing": "0.04em",
          "textTransform": "none"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "letterSpacing": "0.04em"
        },
        "color": {
          "text": "var:preset|color|muted"
        }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline",
                "textUnderlineOffset": "0.28em"
              }
            }
          }
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "width": "1px"
            },
            "color": {
              "background": "transparent",
              "text": "currentColor"
            }
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "var:preset|color|gold",
          "style": "solid",
          "width": "0 0 0 1px"
        },
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|40"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|x-large",
          "fontStyle": "italic",
          "lineHeight": "1.35"
        }
      },
      "core/pullquote": {
        "border": {
          "color": "var:preset|color|gold",
          "style": "solid",
          "width": "1px 0"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|gold"
        },
        "border": {
          "width": "0 0 1px 0",
          "color": "var:preset|color|line"
        }
      },
      "core/search": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "woocommerce/product-price": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "woocommerce/product-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "500"
        }
      },
      "woocommerce/breadcrumbs": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "var:preset|font-size|small",
          "letterSpacing": "0.04em"
        },
        "color": {
          "text": "var:preset|color|muted"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    },
    {
      "area": "uncategorized",
      "name": "product-meta",
      "title": "Product meta"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page without title",
      "postTypes": ["page"]
    },
    {
      "name": "page-narrow",
      "title": "Narrow reading page",
      "postTypes": ["page"]
    }
  ]
}
