{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Night Study",
  "settings": {},
  "styles": {
    "color": {
      "background": "var:preset|color|navy",
      "text": "var:preset|color|ivory"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|ivory"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|ivory",
          "text": "var:preset|color|navy"
        },
        "border": {
          "color": "var:preset|color|ivory"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|paper",
            "text": "var:preset|color|navy"
          }
        }
      },
      "link": {
        ":hover": {
          "color": {
            "text": "var:preset|color|gold"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|parchment"
        }
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "color": "var:preset|color|gold"
        }
      },
      "woocommerce/product-price": {
        "color": {
          "text": "var:preset|color|ivory"
        }
      }
    }
  }
}
